# Copy to secrets/nexus.env (gitignored) and fill in real values.
# Mount mode 0600 — see Spec 12 §Secrets.
#
# Generate bearer tokens:
#   ./deploy/scripts/rotate-tokens.sh
# or manually:
#   openssl rand -base64 24

# Free setup: only GEMINI_API_KEY is required (aistudio.google.com/apikey).
# Leave BRAVE_API_KEY empty → SearXNG handles search. OpenAI/Anthropic
# only needed if you repoint config/llm.toml.
GEMINI_API_KEY=
BRAVE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# LiteLLM fallback alias — set to the same value as GEMINI_API_KEY.
GOOGLE_API_KEY=

NEXUS_HTTP_TOKEN=
NEXUS_MCP_TOKEN=

# Optional: override the LLM provider selected by config/llm.toml. Example: gemini
LLM_DEFAULT_PROVIDER=
# Optional: override the Gemini model. Example: gemini-2.5-flash
GEMINI_MODEL=

DAILY_USD_BUDGET=10.0
ENABLE_QUERY_EXPANSION=false
LOG_LEVEL=INFO
