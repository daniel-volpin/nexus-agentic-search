# Docker Compose example.
# Copy to secrets/nexus.env (gitignored) and fill in real values.
#
# Generate bearer tokens:
#   ./deploy/scripts/rotate-tokens.sh
# or manually:
#   openssl rand -base64 24

# At least one LLM path must work:
# - LM Studio models matching config/llm.toml, or
# - Gemini / Vertex credentials, or
# - another provider after editing config/llm.toml.
GEMINI_API_KEY=
BRAVE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# LiteLLM fallback alias for Gemini-family providers.
GOOGLE_API_KEY=

NEXUS_HTTP_TOKEN=
NEXUS_MCP_TOKEN=

# Optional: override the LLM provider selected by config/llm.toml. Example: gemini
LLM_DEFAULT_PROVIDER=
# Optional: override the Gemini model. Example: gemini-2.5-flash
GEMINI_MODEL=

DAILY_USD_BUDGET=10.0
ENABLE_QUERY_EXPANSION=false
LOG_LEVEL=INFO
