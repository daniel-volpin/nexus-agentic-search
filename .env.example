# Spec 12 §Secrets. Documents every env var the container reads.
# Copy this to secrets/nexus.env and fill in real values. Real
# secrets/*.env files are gitignored; never commit them.

# ---------- search backends ----------
BRAVE_API_KEY=
SEARXNG_BASE_URL=http://searxng:8080
SEARXNG_ENGINES=google,duckduckgo
SEARXNG_API_KEY=

# ---------- LLM providers ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Optional if using Vertex AI instead of Gemini API key:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-sa.json
# VERTEX_PROJECT=your-gcp-project-id
# VERTEX_LOCATION=us-central1
# Or use ADC instead of a key file:
#   gcloud auth application-default login

# ---------- bearer tokens ----------
# Mandatory. ≥ 32 chars. Generate via:
#   openssl rand -base64 24
# Or use deploy/scripts/rotate-tokens.sh.
NEXUS_HTTP_TOKEN=
NEXUS_MCP_TOKEN=

# ---------- budgets ----------
DAILY_USD_BUDGET=10.0

# ---------- logging / telemetry ----------
LOG_LEVEL=INFO
JSON_LOGS=true
METRICS_PORT=9090

# ---------- cache ----------
CACHE_ROOT=/var/lib/nexus/cache
CACHE_TOTAL_SIZE_GB=2.0

# ---------- transport binding (container-internal) ----------
BIND_HOST=0.0.0.0
HTTP_PORT=8186
MCP_PORT=8185

# ---------- toggles ----------
ENABLE_QUERY_EXPANSION=false
STATUS_REVEAL_COST=true

# ---------- llm config path ----------
LLM_CONFIG_PATH=config/llm.toml
