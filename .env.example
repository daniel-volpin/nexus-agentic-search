# Local development example.
# Copy to a local file such as `.env.local`, then `source` it before
# running `uv run python -m nexus.main`.
#
# For Docker Compose, use `secrets/nexus.env.example` instead.

# ---------- search backends ----------
# BRAVE_API_KEY is optional.
# You still need either BRAVE_API_KEY or a reachable SearXNG instance.
BRAVE_API_KEY=
# Local runs usually point at an already-running SearXNG instance.
# Compose users should keep the service-to-service default in
# `secrets/nexus.env.example`.
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_ENGINES=duckduckgo
SEARXNG_API_KEY=

# ---------- LLM providers ----------
# The default profile is LM Studio primary with cloud fallbacks.
# If you do not run LM Studio locally, set Gemini or other provider creds.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# LiteLLM also accepts GOOGLE_API_KEY for Gemini-family providers.
GOOGLE_API_KEY=
LMSTUDIO_BASE_URL=http://127.0.0.1:1234

# Optional if using Vertex AI instead of direct Gemini API access:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-sa.json
# VERTEX_PROJECT=your-gcp-project-id
# VERTEX_LOCATION=global

# ---------- bearer tokens ----------
# Mandatory. Must be at least 32 characters.
NEXUS_HTTP_TOKEN=
NEXUS_MCP_TOKEN=

# ---------- budgets ----------
DAILY_USD_BUDGET=10.0

# ---------- logging / telemetry ----------
LOG_LEVEL=INFO
JSON_LOGS=true
METRICS_PORT=9090

# ---------- cache ----------
CACHE_ROOT=/var/lib/nexus/cache
CACHE_TOTAL_SIZE_GB=2.0

# ---------- transport binding (container-internal) ----------
BIND_HOST=127.0.0.1
HTTP_PORT=8186
MCP_PORT=8185

# ---------- toggles ----------
ENABLE_QUERY_EXPANSION=false
STATUS_REVEAL_COST=true

# ---------- llm config path ----------
LLM_CONFIG_PATH=config/llm.toml
